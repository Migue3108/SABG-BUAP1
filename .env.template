# ==============================================================================
# Auth (Better Auth)
# ==============================================================================
# Local: http://localhost:3000
# Vercel: https://tu-proyecto.vercel.app (o tu dominio personalizado)
BETTER_AUTH_URL=http://localhost:3000

# Genera una clave segura con: openssl rand -base64 32
BETTER_AUTH_SECRET=""

# ==============================================================================
# Base de Datos (PostgreSQL / Supabase / Prisma)
# ==============================================================================
# En Local (Docker):
# DATABASE_URL="postgresql://user:admin@localhost:5432/postgres?schema=public"
# DIRECT_URL="postgresql://user:admin@localhost:5432/postgres?schema=public"

# En Supabase (Vercel / Producción):
# DATABASE_URL: Cadena de conexión con Pooler (Transaction mode, puerto 6543)
DATABASE_URL="postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"

# DIRECT_URL: Cadena de conexión directa (Session mode o puerto 5432) usada para migraciones de Prisma
DIRECT_URL="postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"

# ==============================================================================
# Usuario Administrador Inicial (scripts/create-dev-user.ts)
